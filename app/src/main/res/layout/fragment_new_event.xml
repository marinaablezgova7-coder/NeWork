<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF7FF">

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/event_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Назад"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="New event"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/event_publish"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Опубликовать"
            android:padding="12dp"
            android:src="@drawable/ic_check" />

    </LinearLayout>

    <!-- Основное содержимое -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Текст события -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="О чём хотите рассказать?">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/event_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="5" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Изображение -->
            <ImageView
                android:id="@+id/event_image"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <!-- Нижняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Фото -->
        <ImageButton
            android:id="@+id/event_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Фото"
            android:padding="12dp"
            android:src="@drawable/ic_photo" />

        <!-- Файл -->
        <ImageButton
            android:id="@+id/event_file"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Файл"
            android:padding="12dp"
            android:src="@drawable/ic_attach_file" />

        <!-- Участники -->
        <ImageButton
            android:id="@+id/event_speakers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Участники"
            android:padding="12dp"
            android:src="@drawable/ic_people" />

        <!-- Место -->
        <ImageButton
            android:id="@+id/event_location"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Место"
            android:padding="12dp"
            android:src="@drawable/ic_location" />

        <!-- Плюс -->
        <ImageButton
            android:id="@+id/event_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Дополнительно"
            android:padding="12dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#6750A4" />

    </LinearLayout>

</LinearLayout>