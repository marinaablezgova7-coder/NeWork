<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="#FFF7FF"
    app:cardCornerRadius="8dp"
    app:strokeColor="#D8CEDA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Аватар -->
        <TextView
            android:id="@+id/liker_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ic_account_circle"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Имя + username -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/liker_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adison Levin"
                android:textColor="#222222"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liker_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="jugmmer8"
                android:textColor="#555555"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>