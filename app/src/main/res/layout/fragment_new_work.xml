<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/new_work_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFF7FF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Добавить работу"
        app:titleTextColor="#222222"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КОМПАНИЯ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/work_company_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:hint="Название компании"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/new_work_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/work_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ДОЛЖНОСТЬ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/work_position_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:hint="Должность"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/work_company_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/work_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ДАТА НАЧАЛА -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/work_start_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="Дата начала"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/work_position_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ДАТА ОКОНЧАНИЯ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/work_finish_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:text="Дата окончания"
        android:textAllCaps="false"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/work_start_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- РАБОТАЮ СЕЙЧАС -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/work_current_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Работаю по настоящее время"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/work_finish_button"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- СОХРАНИТЬ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/work_save_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="Сохранить"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#6F4AA8"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>