<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mention_users_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFF7FF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Упомянуть пользователей"
        app:titleTextColor="#222222"
        app:menu="@menu/mention_users_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- СПИСОК ПОЛЬЗОВАТЕЛЕЙ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mention_users_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/mention_users_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>