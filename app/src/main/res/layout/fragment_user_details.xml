<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/user_details_toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFF7FF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Профиль"
        app:titleTextColor="#222222"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- АВАТАР -->
    <TextView
        android:id="@+id/user_details_avatar"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/ic_account_circle"
        android:gravity="center"
        android:text="A"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/user_details_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ИМЯ -->
    <TextView
        android:id="@+id/user_details_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Adison Levin"
        android:textColor="#222222"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/user_details_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЛОГИН -->
    <TextView
        android:id="@+id/user_details_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="jgummera8"
        android:textColor="#777777"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/user_details_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- РАЗДЕЛИТЕЛЬ -->
    <View
        android:id="@+id/profile_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:background="#E5E0E8"
        app:layout_constraintTop_toBottomOf="@id/user_details_login"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ВКЛАДКИ -->
    <LinearLayout
        android:id="@+id/profile_tabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/profile_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/profile_tab_wall"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Стена"
            android:textColor="#6F4AA8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profile_tab_jobs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Работы"
            android:textColor="#777777"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ОБЛАСТЬ СОДЕРЖИМОГО -->
    <FrameLayout
        android:id="@+id/profile_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/profile_tabs"
        app:layout_constraintBottom_toTopOf="@id/logout_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- СТЕНА -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_wall_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- РАБОТЫ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_jobs_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/profile_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Пока нет публикаций"
            android:textColor="#777777"
            android:textSize="14sp" />

    </FrameLayout>

    <!-- КНОПКА ДОБАВЛЕНИЯ РАБОТЫ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_work_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Добавить работу"
        android:src="@drawable/ic_add"
        app:backgroundTint="#E9D8FF"
        app:tint="#222222"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/logout_button" />

    <!-- КНОПКА ВЫХОДА -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/logout_button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="Выйти"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:backgroundTint="#6F4AA8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
